<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SwBridge</PackageId>
    <Version>0.6.0</Version>
    <Authors>Meir Kanevskiy</Authors>
    <Description>MCP-agnostic .NET abstraction over the SolidWorks COM API: attach to a running instance (all COM work serialized on a message-pumping, timeout-bounded STA dispatcher), resolve open documents, read the feature tree generically via schema-driven reflection, discover a late-bound COM object's real members (including the union of every discovery mechanism), read back the identity of the current selection, and write via explicit single-flag COM invocation, strictly read-only dotted path resolution, ownership-aware DTO result conversion and document-state probes.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/meirka8/swbridge</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>solidworks;com;automation;cad</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SolidWorks.Interop.SldWorks" Version="32.1.0" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="32.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
